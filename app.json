{
  "expo": {
    "name": "らくがきロワイヤル",
    "slug": "rakugaki-royale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "rakugaki",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rakugaki.royale"
    },
    "android": {
      "package": "com.rakugaki.royale",
      "adaptiveIcon": {
        "backgroundColor": "#fafafa"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "root": "src/app" }]
    ]
  }
}
